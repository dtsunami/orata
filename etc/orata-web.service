# /etc/systemd/system/orata-web.service
#
#   sudo cp etc/orata-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now orata-web
#   journalctl -u orata-web -f
#
# Requires: apt install python3-fastapi python3-uvicorn

[Unit]
Description=orata web admin
# orata-firstboot must finish first: on a cloned appliance image it
# generates the per-device admin password, so serving before it completes
# would expose an unprovisioned instance.
After=asterisk.service orata-firstboot.service orata-admin.service
Wants=asterisk.service orata-admin.service

[Service]
Type=simple
User=asterisk
Group=asterisk
ExecStart=/usr/bin/python3 /usr/local/bin/orata_web.py
Restart=on-failure
RestartSec=5

# It needs the Asterisk CLI socket, its own config, and the privileged
# helper's socket in /run/orata-admin. It still cannot write /etc/asterisk:
# that is the helper's job and the reason the helper exists.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/run/asterisk /var/log/orata /var/lib/orata
MemoryMax=192M

[Install]
WantedBy=multi-user.target